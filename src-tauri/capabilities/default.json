{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the manager and note windows. Data access goes through DeskNotes commands only.",
  "windows": ["manager", "settings", "note-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "mailto:*" }]
    }
  ]
}
