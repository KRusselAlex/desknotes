{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DeskNotes",
  "version": "0.1.0",
  "identifier": "io.github.krusselalex.desknotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Private sticky notes for your desktop",
    "longDescription": "DeskNotes keeps sticky notes on your desktop. Notes stay on your computer, work offline and need no account.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "KRusselAlex and DeskNotes contributors",
    "homepage": "https://github.com/KRusselAlex/desknotes",
    "copyright": "Copyright (c) 2026 KRusselAlex and DeskNotes contributors",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/share/doc/desk-notes/copyright": "../LICENSE"
        }
      }
    }
  }
}
